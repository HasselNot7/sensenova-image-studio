# 阿里云百炼（Model Studio / DashScope）API 密钥，sk- 开头，在百炼控制台创建
#
# BYOK 模式下，用户在网页右上角「设置」里填自己的 Key（存浏览器 localStorage），
# 本站不需要配置这个变量。仅两种情况才配：
#   1) 自托管单用户：只有你自己用，不想每次在页面里填；
#   2) 部署给固定小圈子共用一把 Key。
# 代理取密钥顺序：请求头 x-qwen-key 优先 → 回退本环境变量 → 都没有返回 config_error。
DASHSCOPE_API_KEY=

# 上游主机名按区域走，Key 与区域必须配对（不通用）。
# 可选值：cn-beijing | ap-southeast-1 | us-east-1 | eu-central-1 | ap-northeast-1 | cn-hongkong | legacy
# legacy = 通用域名 dashscope.aliyuncs.com，不需要业务空间 ID。
QWEN_REGION=cn-beijing

# 业务空间 ID，会拼进主机名：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# 选 legacy 时留空。
QWEN_WORKSPACE_ID=

# 以后加 GPT Image / Nano Banana 时，各家的服务端回退变量名写在 lib/providers.ts 的
# descriptor 里（keyEnv 与 fields[].env），代理按名字读，不需要改 UI 代码。

# ---- 商汤 SenseNova（第二家服务商）----
# 同样只在自托管共用一把 Key 时才需要配；用户自己填的话走浏览器 localStorage。
# 端点固定 https://token.sensenova.cn/v1，没有区域 / 业务空间概念。
SENSENOVA_API_KEY=

# ---- OpenAI GPT Image（第三家服务商）----
# 同样只在自托管共用一把 Key 时才需要配；用户自己填的话走浏览器 localStorage。
# 官方端点 https://api.openai.com/v1（images/generations 与 images/edits），没有区域概念。
# 注意：2026-09-29 实测这台机器直连 api.openai.com 不通（curl 21s 超时），
# 所以设置界面给了「上游地址」一栏，可以填自己的 OpenAI 兼容网关（要含 /v1）。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- 蒸馏模型（可选：出图前把 SKILL 原文压进提示词上限）----
# 走 OpenAI 兼容的 POST {DISTILL_BASE_URL}/chat/completions。
# 用户也可以在网页「设置 · 蒸馏模型」里各填各的（含模型名与目标 token），这里只作服务端兜底。
DISTILL_BASE_URL=
DISTILL_API_KEY=
